# ── Supabase ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── RevenueCat (Android) ───────────────────────────────────────────────────────
# Get this from: RevenueCat Dashboard → Project → API Keys → Public (Android)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your_revenuecat_android_key

# ── RevenueCat (Web entitlement check) ────────────────────────────────────────
# ⚠️ SECURITY: This is a Secret Key (sk_...) — NEVER commit real values.
# Before production, move this to a Supabase Edge Function (server-side only).
# Get from: RevenueCat Dashboard → Project → API Keys → Secret
EXPO_PUBLIC_REVENUECAT_SECRET_KEY=your_revenuecat_secret_key

# ── Stripe Web Checkout (production links) ────────────────────────────────────
# Create Payment Links in Stripe Dashboard → Payment Links
# ⚠️ Use LIVE mode links (no "test_" prefix) for production
EXPO_PUBLIC_STRIPE_LINK_MONTHLY=https://buy.stripe.com/your_monthly_link
EXPO_PUBLIC_STRIPE_LINK_LIFETIME=https://buy.stripe.com/your_lifetime_link
